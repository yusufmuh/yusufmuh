# Copy to .env and fill in. Do NOT put account passwords here.
# Use Google OAuth (credentials.json) — never store Gmail passwords in this project.

# Calendar that receives all detected meetings (usually your primary Gmail)
PRIMARY_CALENDAR_ID=primary

# How many minutes before a meeting to open Zoom
ZOOM_OPEN_MINUTES_BEFORE=2

# How far back to scan emails on first run (days)
EMAIL_LOOKBACK_DAYS=14

# Poll interval while watching (seconds)
POLL_INTERVAL_SECONDS=120

# Timezone for naive datetimes found in email bodies
DEFAULT_TIMEZONE=Asia/Jakarta
